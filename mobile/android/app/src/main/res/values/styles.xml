<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. Oscuro (no el Light.DarkActionBar original
         de la plantilla): por las dudas alguna ventana/diálogo la use antes
         de que MainActivity aplique su propio tema, de abajo. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/colorPrimary</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/colorPrimary</item>
    </style>


    <!-- Sin logo ni imagen: solo el color de fondo oscuro del tema de la
         app (mismo que colorPrimary, la variable mt bg app del CSS), para
         que no haya ningún destello blanco entre el arranque nativo y la
         propia intro de MIP (ver SplashGate en el JS): pasan a verse como
         una sola pantalla continua.

         android:windowBackground (no android:background, que en un tema de
         ventana no hace nada) es lo que realmente pinta la "ventana de
         arranque" que Android muestra antes de que exista la Activity — el
         error de la vez pasada fue justamente usar el atributo que no
         corresponde. windowSplashScreenBackground cubre además la pantalla
         de arranque nativa real de Android 12+. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/colorPrimary</item>
        <item name="windowSplashScreenBackground">@color/colorPrimary</item>
    </style>
</resources>